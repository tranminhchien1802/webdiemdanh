# Cấu hình cho local dev (KHÔNG commit file này — .env đã bị gitignore)
# Copy ra file `.env` và điền giá trị
#
# === RAILWAY (production) ===
# DATABASE_URL phải trỏ tới ổ đĩa bền (volume). Tạo volume "data" mount vào /data,
# rồi đặt: DATABASE_URL="file:/data/app.db"
#
# === LOCAL DEV ===
# DATABASE_URL="file:./dev.db"

DATABASE_URL="file:./dev.db"

# Sinh bằng lệnh: npx auth secret
AUTH_SECRET="thay-bang-gia-tri-auth-secret"

# Bắt buộc true khi chạy sau proxy (Railway/Vercel)
AUTH_TRUST_HOST=true