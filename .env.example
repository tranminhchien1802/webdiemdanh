# === PRODUCTION (Vercel) ===
# Sử dụng PostgreSQL hosted (Vercel Postgres, Supabase, Neon, v.v.)
# Format: postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Optional: Cho pooling connections (PgBouncer)
# DATABASE_URL_UNPOOLED="postgresql://user:password@host:5432/dbname?sslmode=require"

# Tạo secret: npx auth secret
AUTH_SECRET="your-secret-key-here-generate-with-npx-auth-secret"

# Bắt buộc true khi chạy sau proxy (Vercel/Railway)
AUTH_TRUST_HOST="true"

# === LOCAL DEVELOPMENT (không cần commit) ===
# Nếu chạy local, có thể dùng database local hoặc remote
# Ví dụ local: DATABASE_URL="postgresql://postgres:password@localhost:5432/webdiemdanh"