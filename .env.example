# Cấu hình cho local dev (KHÔNG commit file này — .env đã bị gitignore)
# Copy ra file `.env` và điền giá trị
#
# === VERCEL / PRODUCTION ===
# DATABASE_URL là Postgres hosted (Neon / Vercel Postgres / Supabase):
#   postgresql://user:password@host:5432/dbname?sslmode=require

DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Sinh bằng lệnh: npx auth secret
AUTH_SECRET="thay-bang-gia-tri-auth-secret"

# Bắt buộc true khi chạy sau proxy (Vercel/Railway)
AUTH_TRUST_HOST=true